# Terraform provider cache, state, and keys. Keep *.tf and .terraform.lock.hcl.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.pem
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
!*.tfvars.example

ssh.ps1
ssh-stage.ps1

# Secrets. *.env.example stays tracked.
.env
.env.*
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]

# Node and build output
node_modules/
dist/
dist-ssr/
build/
coverage/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
